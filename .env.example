# Hermes Deploy Environment Variables

# Local Ollama endpoint (http://host.docker.internal:11434 in Docker, http://127.0.0.1:11434 locally)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Harness endpoint (http://host.docker.internal:8000 in Docker, http://127.0.0.1:8000 locally)
HARNESS_BASE_URL=http://127.0.0.1:8000

# Target project directory inside container or host
WORKSPACE_DIR=.

# Local model identifier
MODEL_ID=devstral:24b

# Ollama context window. NOT VRAM-constrained at this size: measured on gemma4:12b /
# RTX 3060, 8192 -> 7986MB resident and 32768 -> 7718MB, i.e. 4x the window for ~116 MiB.
# The loop never trims message history, so 8192 could not hold two source files and the
# task prompt at once - Ollama silently dropped the prompt and the agent wandered.
# NOTE: nothing in the code loads this file. config.py reads os.getenv directly, so these
# values apply only to docker-compose; a host run uses the defaults in config.py.
NUM_CTX=32768

# HTTP timeout for one /api/chat call, seconds. A turn that calls write_file emits the
# ENTIRE FILE as output tokens, and generation is the slow half. Measured on this box:
# devstral:24b 3.4 tok/s, qwen3-coder:30b 21.2, gemma4:12b 36.1 - so a 4000-token write
# takes ~20 minutes on devstral against ~2 minutes on gemma4. Size this from whatever is
# in MODEL_ID; the two must be revisited together.
OLLAMA_TIMEOUT_S=1800

# Disables the model's own chain-of-thought block. Neither devstral nor qwen3-coder is a
# thinking model, so this is a no-op for them; it mattered for gemma4, which spent every
# allotted token reasoning and returned empty content.
THINKING_MODE=false

# Circuit breaker stuck loop threshold (consecutive identical tool turns)
STUCK_LOOP_THRESHOLD=3

# Maximum agent turn limit per task. A real task (read guardrails, read 2-3 files, write
# a module, write tests, run pytest, fix, re-run) is comfortably 25+ turns. The
# stuck-loop breaker, not this limit, is what should stop a spinning agent.
MAX_TURNS=50
